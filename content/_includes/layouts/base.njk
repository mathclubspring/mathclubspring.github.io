<!doctype html>
<html lang="ru">
  <head>
    {% set canonicalUrl = "https://mathclubspring.github.io" ~ page.url %}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if title %}{{ title }} — {% endif %}Математический клуб</title>
    <link rel="canonical" href="{{ canonicalUrl }}">

    <meta property="og:locale" content="ru_RU">
    <meta property="og:type" content="{% if page.url == "/" %}website{% else %}article{% endif %}">
    <meta property="og:site_name" content="Математический клуб">
    <meta property="og:title" content="Математический клуб">
    <meta property="og:url" content="{{ canonicalUrl }}">
    <link rel="stylesheet" href="/assets/site.css">
  </head>
  <body>
    <a class="skip-link" href="#main-content">К основному содержимому</a>
    <header class="site-header">
      <a class="site-name" href="/">Математический клуб</a>
      <nav aria-label="Основная навигация">
        <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Главная</a>
        <a href="/materials/"{% if "/materials/" in page.url %} aria-current="page"{% endif %}>Материалы</a>
        <a href="/games/"{% if "/games/" in page.url %} aria-current="page"{% endif %}>Игры</a>
        <a href="/events/"{% if "/events/" in page.url %} aria-current="page"{% endif %}>Календарь</a>
        <a href="/olympiads/"{% if "/olympiads/" in page.url %} aria-current="page"{% endif %}>Наши мероприятия</a>
      </nav>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer>
      <p>Математический клуб</p>
      <nav aria-label="Дополнительная навигация">
        <a href="/contacts/">Контакты</a>
        <a href="/merch/">Наш мерч</a>
        <a href="/privacy/">Privacy Policy</a>
      </nav>
    </footer>
  </body>
</html>
